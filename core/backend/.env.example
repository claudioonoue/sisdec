# Banco de dados (credenciais do docker-compose.yml na raiz do repositório)
DATABASE_URL="postgresql://sisdec:sisdec@localhost:5432/sisdec?schema=public"

# Aplicação
PORT=3000

# Autenticação
JWT_SECRET="defina-uma-chave-secreta"
JWT_EXPIRES_IN="8h"

# Anexos
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Origens permitidas (portais)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
